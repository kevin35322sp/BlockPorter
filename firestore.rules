rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function sameMoney(next, prev) {
      return next.fromChain == prev.fromChain
        && next.toChain == prev.toChain
        && next.fromToken == prev.fromToken
        && next.toToken == prev.toToken
        && next.fromAmount == prev.fromAmount
        && next.toAmount == prev.toAmount
        && next.senderAddress == prev.senderAddress
        && next.payoutAddress == prev.payoutAddress
        && next.depositAddress == prev.depositAddress
        && next.txHash == prev.txHash
        && next.createdAt == prev.createdAt;
    }
    function sameCoin(next, prev) {
      return next.orderNo == prev.orderNo
        && next.orderedAt == prev.orderedAt
        && next.chain == prev.chain
        && next.fromToken == prev.fromToken
        && next.toToken == prev.toToken
        && next.fromAmount == prev.fromAmount
        && next.toAmount == prev.toAmount
        && next.payoutAddress == prev.payoutAddress
        && next.depositAddress == prev.depositAddress
        && next.fullName == prev.fullName
        && next.email == prev.email
        && next.contactKind == prev.contactKind
        && next.contact == prev.contact
        && next.memo == prev.memo
        && next.fee == prev.fee
        && next.bonus == prev.bonus
        && next.createdAt == prev.createdAt;
    }

    match /admins/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /config/wallets {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/pricing {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.feeEnabled is bool
        && request.resource.data.bonusPercent is number
        && request.resource.data.bonusPercent >= 0
        && request.resource.data.bonusPercent <= 100
        && request.resource.data.swapFeeEnabled is bool
        && request.resource.data.swapBonusPercent is number
        && request.resource.data.swapBonusPercent >= 0
        && request.resource.data.swapBonusPercent <= 100
        && request.resource.data.crossSwapEnabled is bool
        && request.resource.data.coinSwapEnabled is bool;
    }

    match /orders/{id} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.fromAmount is string
        && request.resource.data.toAmount is string
        && request.resource.data.txHash is string
        && request.resource.data.txHash.size() > 8
        && request.resource.data.txHash.size() < 200
        && request.resource.data.senderAddress is string
        && request.resource.data.payoutAddress is string
        && request.resource.data.depositAddress is string;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && sameMoney(request.resource.data, resource.data)
        && request.resource.data.status in ["pending", "paid"];
      allow delete: if false;
    }

    match /coinOrders/{id} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.orderNo is int
        && request.resource.data.orderNo >= 1
        && request.resource.data.orderNo <= 100
        && request.resource.data.orderedAt is string
        && request.resource.data.orderedAt.size() >= 16
        && request.resource.data.orderedAt.size() <= 40
        && request.resource.data.chain in ["ethereum", "bsc", "polygon", "optimism", "arbitrum", "ton"]
        && request.resource.data.fromToken in ["ETH", "USDC", "USDT", "MATIC", "BNB", "TON"]
        && request.resource.data.toToken in ["ETH", "USDC", "USDT", "MATIC", "BNB", "TON"]
        && request.resource.data.fromToken != request.resource.data.toToken
        && request.resource.data.fromAmount is string
        && request.resource.data.fromAmount.size() > 0
        && request.resource.data.fromAmount.size() < 40
        && request.resource.data.toAmount is string
        && request.resource.data.toAmount.size() > 0
        && request.resource.data.toAmount.size() < 40
        && request.resource.data.payoutAddress is string
        && request.resource.data.payoutAddress.size() > 8
        && request.resource.data.payoutAddress.size() < 120
        && request.resource.data.depositAddress is string
        && request.resource.data.depositAddress.size() > 8
        && request.resource.data.depositAddress.size() < 120
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 240
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.contactKind in ["telegram", "whatsapp", "phone"]
        && request.resource.data.contact is string
        && request.resource.data.contact.size() >= 3
        && request.resource.data.contact.size() <= 80
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 480
        && request.resource.data.fee is string
        && request.resource.data.fee.size() < 16
        && request.resource.data.bonus is string
        && request.resource.data.bonus.size() < 16;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && sameCoin(request.resource.data, resource.data)
        && request.resource.data.status in ["pending", "paid"];
      allow delete: if false;
    }
  }
}
